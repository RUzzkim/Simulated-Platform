{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simulated-platform.local/contract/v2_experiment_event.schema.json",
  "title": "V2.0 实验故障/决策事件",
  "description": "契约版本 2.0.0；发布到 simulation/{sim}/experiment_event。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "event_type",
    "timestamp",
    "sim_time_s",
    "fault_type",
    "joint_index",
    "action",
    "reason",
    "reachability_status"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "event_type": {
      "type": "string",
      "enum": ["FAULT", "DECISION"]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999
    },
    "sim_time_s": {
      "type": "number",
      "minimum": 0
    },
    "fault_type": {
      "enum": ["JOINT_LOCKED", null]
    },
    "joint_index": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 5
    },
    "action": {
      "enum": ["RECOVER", "STOP", null]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "reachability_status": {
      "enum": ["REACHABLE", "NO_FEASIBLE_PLAN", "NOT_ASSESSED", null]
    },
    "detail": {
      "type": ["string", "null"]
    }
  }
}
