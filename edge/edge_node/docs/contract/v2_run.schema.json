{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simulated-platform.local/contract/v2_run.schema.json",
  "title": "V2.0 单关节卡滞任务恢复 Run 记录",
  "description": "契约版本 2.0.0；与 docs/v2-experiment-contract.md 同步。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "algorithm_version",
    "started_at_ms",
    "simulation",
    "scenario",
    "fault",
    "reachability",
    "strategy",
    "decision",
    "task",
    "trace"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "algorithm_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "started_at_ms": {
      "type": "integer",
      "minimum": 1000000000000,
      "maximum": 9999999999999
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_id", "robot_id", "plant", "control_hz", "duration_s"],
      "properties": {
        "simulation_id": {
          "type": "string",
          "pattern": "^SIM-\\d{3}$"
        },
        "robot_id": {
          "type": "string",
          "pattern": "^ROBOT-\\d{3}$"
        },
        "plant": {
          "type": "string",
          "enum": ["python-6r", "ros2-gazebo"]
        },
        "control_hz": {
          "type": "integer",
          "const": 100
        },
        "duration_s": {
          "type": "number",
          "const": 8.0
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "split", "seed", "task_goal_rad", "description"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^(?:(?:DEVELOPMENT|EXPLORATORY|VALIDATION)-)?LOCK-J[0-5]#s[1-3]T[1-2]$"
        },
        "split": {
          "type": "string",
          "enum": ["development", "exploratory", "validation"]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "task_goal_rad": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "joint_index",
        "joint_name",
        "injected_at_s",
        "detected_at_s",
        "detection_latency_ms",
        "confirmed"
      ],
      "properties": {
        "type": {
          "const": "JOINT_LOCKED"
        },
        "joint_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "joint_name": {
          "type": "string",
          "pattern": "^J[0-5]$"
        },
        "injected_at_s": {
          "type": "number",
          "minimum": 0
        },
        "detected_at_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "detection_latency_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["REACHABLE", "NO_FEASIBLE_PLAN", "NOT_ASSESSED"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "planner_position_error_m": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "strategy": {
      "type": "string",
      "enum": ["off", "v1", "v2"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason", "at_s"],
      "properties": {
        "action": {
          "enum": ["RECOVER", "STOP", null]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "at_s": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "final_ee_error_m",
        "recovery_time_s",
        "stop_time_s",
        "peak_fault_joint_torque_nm",
        "max_joint_speed_rad_s",
        "max_joint_torque_nm"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["RECOVERED", "SAFE_STOPPED", "FAILED", "NOT_APPLICABLE"]
        },
        "final_ee_error_m": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "recovery_time_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "stop_time_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "peak_fault_joint_torque_nm": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "max_joint_speed_rad_s": {
          "type": "number",
          "minimum": 0
        },
        "max_joint_torque_nm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "frame_count", "sample_rate_hz"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "const": 100
        }
      }
    },
    "source_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
