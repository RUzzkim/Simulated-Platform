MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MQTT_SERVICE_USERNAME=cloud-service
MQTT_SERVICE_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# 生产必须换成随机值：JWT 签名密钥 >=32 字节，设备凭据加密密钥 >=16 字符
JWT_SECRET=change-me-please-use-a-random-32byte-secret
CREDENTIAL_KEY=change-me-please-use-a-random-key
# 双向认证：deploy/certs/cloud-service.p12 的口令（生产改成随机值）
MQTT_CLIENT_KEYSTORE_PASSWORD=change-me-client-keystore
# 回填给边缘端/仿真端的 MQTT broker 公网地址（生产：公网域名或 IP + 8883；本地：127.0.0.1 + 8884）
EDGE_BROKER_HOST=your-cloud-domain-or-ip
EDGE_BROKER_PORT=8883
# 本项目 HTTP 入口（生产 8082，宿主机 80 被 xinqing-frontend 占用）：
# 无域名/自签证书时必须是 0（直接提供页面），设为 1 会 301 到自签 443，手机/微信打不开
NGINX_HTTP_REDIRECT=0
