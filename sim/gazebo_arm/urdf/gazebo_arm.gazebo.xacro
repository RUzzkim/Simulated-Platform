<?xml version="1.0"?>
<!-- Gazebo 骨架：复用生成的几何/惯量 URDF，叠加 world 锚点 + ros2_control + gazebo_ros2_control 插件。
     用法（launch 里用 xacro 处理）：xacro gazebo_arm.gazebo.xacro
     控制：6 关节 position 命令接口 + position/velocity/effort 状态接口；
     控制器配置见 config/arm_controllers.yaml。 -->
<robot name="hydraulic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 复用 gen_urdf.py 生成的连杆/关节/惯量/碰撞几何 -->
  <xacro:include filename="$(find gazebo_arm)/urdf/hydraulic_arm.urdf"/>

  <!-- 固定到世界，作为基座锚点（否则整臂会掉下去） -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ros2_control 硬件：6 关节，position 命令 + position/velocity/effort 状态 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:macro name="arm_joint" params="n">
      <joint name="joint_${n}">
        <command_interface name="position">
          <param name="min">-3.1416</param>
          <param name="max">3.1416</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:arm_joint n="1"/>
    <xacro:arm_joint n="2"/>
    <xacro:arm_joint n="3"/>
    <xacro:arm_joint n="4"/>
    <xacro:arm_joint n="5"/>
    <xacro:arm_joint n="6"/>
  </ros2_control>

  <!-- gazebo_ros2_control 插件：加载控制器管理器 + 控制器配置 -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find gazebo_arm)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Gazebo 材质配色（Gazebo 用自己的材质名，不读 URDF <material> 颜色） -->
  <gazebo reference="link_1"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="link_2"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="link_3"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="link_4"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link_5"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link_6"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="gripper_base"><material>Gazebo/Yellow</material></gazebo>
  <gazebo reference="finger_left"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="finger_right"><material>Gazebo/DarkGrey</material></gazebo>
</robot>
