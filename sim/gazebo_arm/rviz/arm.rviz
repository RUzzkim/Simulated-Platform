Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Scene
      Enabled: false
      Topic:
        Value: /scene
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: End Effector Trajectory
      Enabled: true
      Topic:
        Value: /arm_trajectory
        Durability Policy: Volatile
        Depth: 5
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
    Background Color: 140; 140; 145
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.45
      Focal Point:
        X: 0.37
        Y: 0.0
        Z: 0.28
      Pitch: 0.36
      Yaw: 0.8
Window Geometry:
  Height: 720
  Width: 1200
