<?xml version="1.0"?>
<!-- 钢铁后处理车间现场：地面 + 上料线 + 钢管料垛 + 型钢 + 钢坯 + 分拣料框。
     工件为 static（布景/碰撞用；抓取物理需额外夹爪驱动，属后续）。机械臂基座在世界原点。 -->
<sdf version="1.6">
  <world name="steel_yard">
    <!-- 状态插件：提供 /gazebo/get_entity_state、set_entity_state 与 link_states/model_states，
         供运动学吸附抓取（grasp_node）读夹爪位姿、写工件位姿 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50.0</update_rate>
    </plugin>
    <!-- 自带光照 + 地面（不用 model://sun/ground_plane，避免离线/代理环境去在线模型库下载而卡住） -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 上料输送带（右前） -->
    <model name="conveyor">
      <static>true</static>
      <pose>0.90 0.30 0.10 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.45 1.30 0.20</size></box></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.45 1.30 0.20</size></box></geometry></collision>
      </link>
    </model>

    <!-- 钢管料垛（躺在料线上，沿 y） -->
    <model name="pipe_1">
      <static>true</static>
      <pose>0.86 0.10 0.28 1.5708 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.05</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.60 0.62 0.66 1</ambient><diffuse>0.62 0.64 0.68 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.70</length></cylinder></geometry></collision>
      </link>
    </model>
    <model name="pipe_2">
      <static>true</static>
      <pose>0.86 0.30 0.28 1.5708 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.05</radius><length>0.70</length></cylinder></geometry>
          <material><ambient>0.55 0.42 0.30 1</ambient><diffuse>0.60 0.45 0.32 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.70</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- 型钢（H 型钢近似方料） -->
    <model name="beam">
      <static>true</static>
      <pose>0.55 0.62 0.06 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.55 0.10 0.10</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.58 0.60 0.63 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.55 0.10 0.10</size></box></geometry></collision>
      </link>
    </model>

    <!-- 钢坯（抓取对象）：kinematic —— 不受接触力影响(避免被 teleport 的臂打飞)，
         但可被 set_entity_state 移动，正合运动学吸附抓取 -->
    <model name="billet">
      <static>false</static>
      <pose>0.70 -0.32 0.10 0 0 0</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="v">
          <geometry><box><size>0.16 0.16 0.16</size></box></geometry>
          <material><ambient>0.50 0.30 0.20 1</ambient><diffuse>0.58 0.34 0.22 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.16 0.16 0.16</size></box></geometry></collision>
      </link>
    </model>

    <!-- 分拣料框（黄色） -->
    <model name="bin_a">
      <static>true</static>
      <pose>0.30 -0.65 0.10 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.35 0.35 0.20</size></box></geometry>
          <material><ambient>0.80 0.68 0.12 1</ambient><diffuse>0.85 0.72 0.15 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.35 0.35 0.20</size></box></geometry></collision>
      </link>
    </model>
    <model name="bin_b">
      <static>true</static>
      <pose>-0.60 -0.35 0.10 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.35 0.35 0.20</size></box></geometry>
          <material><ambient>0.80 0.68 0.12 1</ambient><diffuse>0.85 0.72 0.15 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.35 0.35 0.20</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>

